    "v_completed_fighter_fights": {
      "description": "Canonical completed fighter-side fight view for recent fights, records, and rates.",
      "source_views": ["v_fighter_fight_results"],
      "preferred_for": [
        "completed recent fights",
        "UFC fight-side records",
        "win/loss/draw/no-contest counts",
        "method category filters"
      ],
      "metric_policies": [
        "completed_fight = event_date <= current_date and result IS NOT NULL",
        "exclude non-completed Tapology statuses with COALESCE(bout_status, 'completed') NOT IN ('scheduled', 'cancelled', 'postponed')",
        "bout_status is sparse, so NULL is treated as completed only when result/date conditions are satisfied",
        "KO/TKO bucket uses method ILIKE 'KO/TKO%' first; KO-% and TKO-% are accepted only for future or legacy data"
      ],
      "columns": [
        {"column": "fighter_id", "type": "integer", "description": "Fighter id"},
        {"column": "fighter_name", "type": "character varying", "description": "Fighter full name"},
        {"column": "fighter_match_id", "type": "integer", "description": "Fighter-side row id"},
        {"column": "match_id", "type": "integer", "description": "Fight/match id"},
        {"column": "event_id", "type": "integer", "description": "Event id"},
        {"column": "event_name", "type": "character varying", "description": "Event name"},
        {"column": "event_date", "type": "date", "description": "Event date"},
        {"column": "weight_class_id", "type": "integer", "description": "Weight class id"},
        {"column": "weight_class_name", "type": "character varying", "description": "Weight class name"},
        {"column": "result", "type": "character varying", "description": "Fighter-side result"},
        {"column": "method", "type": "character varying", "description": "Bout finish method"},
        {"column": "is_title_bout", "type": "boolean", "description": "Whether this fight is a title bout"},
        {"column": "has_fight_of_the_night_bonus", "type": "boolean", "description": "Whether this fight received Fight of the Night bonus"},
        {"column": "has_performance_of_the_night_bonus", "type": "boolean", "description": "Whether this fighter received Performance of the Night bonus"},
        {"column": "is_win", "type": "boolean", "description": "result = 'win'"},
        {"column": "is_loss", "type": "boolean", "description": "result = 'loss'"},
        {"column": "is_draw", "type": "boolean", "description": "result = 'draw'"},
        {"column": "is_no_contest", "type": "boolean", "description": "result = 'nc'"},
        {"column": "is_ko_tko", "type": "boolean", "description": "method is KO/TKO"},
        {"column": "is_submission", "type": "boolean", "description": "method is submission"},
        {"column": "is_decision", "type": "boolean", "description": "method is decision"},
        {"column": "is_finish", "type": "boolean", "description": "method is KO/TKO or submission"}
