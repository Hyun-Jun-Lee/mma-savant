{
  "database_info": {
    "name": "MMA Savant Database",
    "naming_convention": "singular_table_names",
    "important_notes": [
      "All table names use SINGULAR form (match, fighter, event, ranking)",
      "NEVER use plural forms (matches, fighters, events, rankings)",
      "Primary keys are always 'id' column with integer type",
      "All tables have 'created_at' and 'updated_at' timestamp columns"
    ]
  },
  "query_map": [
    {
      "topic": "Fighter fight results, records, recent fights",
      "guidance": [
        "Prefer v_completed_fighter_fights for completed recent fights, records, win/loss counts, and method summaries.",
        "Use v_fighter_fight_results when scheduled, cancelled, or postponed bouts may matter.",
        "Prefer v_fighter_opponents for opponent, common-opponent, and recent-opponent questions."
      ]
    },
    {
      "topic": "Current champions and rankings",
      "guidance": [
        "Prefer v_current_rankings.",
        "ranking = 0 means champion."
      ]
    },
    {
      "topic": "Record and win-rate summaries",
      "guidance": [
        "Prefer v_fighter_record_summary.",
        "Default win rate is wins / (wins + losses + draws + no_contests)."
      ]
    },
    {
      "topic": "KO/TKO, submission, decision, and finish rates",
      "guidance": [
        "Prefer v_fighter_method_summary.",
        "Current DB canonical KO/TKO pattern is method ILIKE 'KO/TKO%'.",
        "Default finish rate is finish_wins / total_completed_fights."
      ]
    },
    {
      "topic": "Raw table fallback",
      "guidance": [
        "Use raw tables only when the requested dimension is outside the canonical view scope.",
        "Do not reimplement a view's metric definition with ad hoc joins unless the query requires dimensions the view does not expose."
      ]
    }
  ],
  "tables": {
    "fighter": {
      "description": "UFC fighter basic information and records",
      "relationships": {
        "fighter_match": "1:N - Fighter participates in multiple matches",
        "ranking": "1:N - Fighter can have rankings in multiple weight classes",
        "fighter_promotion_record": "1:N - Fighter can have Tapology career records by promotion",
        "fighter_method_record": "1:N - Fighter can have Tapology career records by result method"
      },
      "indexes": [
        {
          "name": "idx_fighter_tapology_url",
          "columns": ["tapology_url"],
          "description": "Lookup index for Tapology fighter profile matching"
        },
        {
          "name": "idx_fighter_tapology_attempt_status",
          "columns": ["tapology_attempt_status"],
          "description": "Lookup index for Tapology fighter enrichment attempt status"
        },
        {
          "name": "idx_fighter_tapology_last_attempt_at",
          "columns": ["tapology_last_attempt_at"],
          "description": "Lookup index for Tapology fighter enrichment retry scheduling"
        }
      ],
      "columns": [
        {
          "column": "name",
          "type": "character varying",
          "nullable": false,
          "description": "Fighter full name"
        },
        {
          "column": "nickname",
          "type": "character varying",
          "nullable": true,
          "description": "Fighter nickname"
        },
        {
          "column": "wins",
          "type": "integer",
          "nullable": true,
          "description": "Total wins"
        },
        {
          "column": "losses",
          "type": "integer",
          "nullable": true,
          "description": "Total losses"
        },
        {
          "column": "draws",
          "type": "integer",
          "nullable": true,
          "description": "Total draws"
        },
        {
          "column": "height",
          "type": "double precision",
          "nullable": true,
          "description": "Height in inches"
        },
        {
          "column": "height_cm",
          "type": "double precision",
          "nullable": true,
          "description": "Height in centimeters"
        },
        {
          "column": "weight",
          "type": "double precision",
          "nullable": true,
          "description": "Weight in pounds"
        },
        {
          "column": "weight_kg",
          "type": "double precision",
          "nullable": true,
          "description": "Weight in kilograms"
        },
        {
          "column": "reach",
          "type": "double precision",
          "nullable": true,
          "description": "Reach in inches"
        },
        {
          "column": "reach_cm",
          "type": "double precision",
          "nullable": true,
          "description": "Reach in centimeters"
        },
        {
          "column": "stance",
          "type": "character varying",
          "nullable": true,
          "description": "Fighting stance",
          "value_format": {
            "possible_values": [
              "switch",
              "orthodox",
              "open stance",
              "southpaw",
              "sideways"
            ]
          }
        },
        {
          "column": "birthdate",
          "type": "character varying",
          "nullable": true,
          "description": "Birth date"
        },
        {
          "column": "belt",
          "type": "boolean",
          "nullable": true,
          "description": "Currently holds a championship belt",
          "notes": "true = currently holds belt"
        },
        {
          "column": "detail_url",
          "type": "character varying",
          "nullable": true,
          "description": "URL to fighter detail page on source site"
        },
        {
          "column": "nationality",
          "type": "character varying",
          "nullable": true,
          "description": "Fighter nationality / country"
        },
        {
          "column": "tapology_url",
          "type": "character varying",
          "nullable": true,
          "description": "URL to fighter profile on Tapology"
        },
        {
          "column": "born",
          "type": "character varying",
          "nullable": true,
          "description": "Birthplace or born information from Tapology"
        },
        {
          "column": "fighting_out_of",
          "type": "character varying",
          "nullable": true,
          "description": "Fighter's fighting-out-of location from Tapology"
        },
        {
          "column": "affiliation",
          "type": "character varying",
          "nullable": true,
          "description": "Fighter affiliation from Tapology"
        },
        {
          "column": "gym",
          "type": "character varying",
          "nullable": true,
          "description": "Fighter gym or team from Tapology"
        },
        {
          "column": "current_streak",
          "type": "character varying",
          "nullable": true,
          "description": "Current career streak from Tapology"
        },
        {
          "column": "last_fight_name",
          "type": "character varying",
          "nullable": true,
          "description": "Most recent Tapology fight label"
        },
        {
          "column": "last_fight_date",
          "type": "date",
          "nullable": true,
          "description": "Date of most recent Tapology fight"
        },
        {
          "column": "last_fight_promotion",
          "type": "character varying",
          "nullable": true,
          "description": "Promotion of most recent Tapology fight"
        },
        {
          "column": "tapology_last_scraped_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "description": "Timestamp when Tapology fighter enrichment last succeeded"
        },
        {
          "column": "tapology_attempt_status",
          "type": "character varying",
          "nullable": true,
          "description": "Last Tapology fighter enrichment attempt status"
        },
        {
          "column": "tapology_last_attempt_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "description": "Timestamp when Tapology fighter enrichment was last attempted"
        },
        {
          "column": "tapology_failure_stage",
          "type": "character varying",
          "nullable": true,
          "description": "Tapology fighter enrichment stage that last failed"
        },
        {
          "column": "tapology_failure_reason",
          "type": "character varying",
          "nullable": true,
          "description": "Short reason for the last Tapology fighter enrichment failure"
        }
      ]
    },
    "fighter_promotion_record": {
      "description": "Tapology career record split by promotion",
      "relationships": {
        "fighter": "N:1 - Promotion record belongs to one fighter with ON DELETE CASCADE"
      },
      "constraints": [
        {
          "name": "fk_fighter_promotion_record_fighter",
          "type": "foreign_key",
          "columns": ["fighter_id"],
          "references": "fighter(id)",
          "on_delete": "CASCADE"
        },
        {
          "name": "uq_fighter_promotion_record_key",
          "type": "unique",
          "columns": ["fighter_id", "promotion_name"],
          "description": "One promotion-level Tapology record per fighter and promotion"
        }
      ],
      "indexes": [
        {
          "name": "idx_fighter_promotion_record_fighter_id",
          "columns": ["fighter_id"],
          "description": "Lookup index for all Tapology promotion records for a fighter"
        },
        {
          "name": "idx_fighter_promotion_record_name",
          "columns": ["promotion_name"],
          "description": "Lookup index for aggregation by promotion"
        },
        {
          "name": "uq_fighter_promotion_record_key",
          "columns": ["fighter_id", "promotion_name"],
          "unique": true,
          "description": "Idempotent upsert key for Tapology promotion records"
        }
      ],
      "columns": [
        {
          "column": "fighter_id",
          "type": "integer",
          "nullable": false,
          "description": "Foreign key to fighter"
        },
        {
          "column": "promotion_name",
          "type": "character varying",
          "nullable": false,
          "description": "Promotion name from Tapology"
        },
        {
          "column": "wins",
          "type": "integer",
          "nullable": true,
          "description": "Wins in this promotion"
        },
        {
          "column": "losses",
          "type": "integer",
          "nullable": true,
          "description": "Losses in this promotion"
        },
        {
          "column": "draws",
          "type": "integer",
          "nullable": true,
          "description": "Draws in this promotion"
        },
        {
          "column": "no_contests",
          "type": "integer",
          "nullable": true,
          "description": "No-contests in this promotion"
        }
      ]
    },
    "fighter_method_record": {
      "description": "Tapology career record split by result and method category",
      "relationships": {
        "fighter": "N:1 - Method record belongs to one fighter with ON DELETE CASCADE"
      },
      "constraints": [
        {
          "name": "fk_fighter_method_record_fighter",
          "type": "foreign_key",
          "columns": ["fighter_id"],
          "references": "fighter(id)",
          "on_delete": "CASCADE"
        },
        {
          "name": "uq_fighter_method_record_key",
          "type": "unique",
          "columns": ["fighter_id", "scope", "result", "method_category"],
          "description": "One method-level Tapology record per fighter, scope, result, and method category"
        }
      ],
      "indexes": [
        {
          "name": "idx_fighter_method_record_fighter_id",
          "columns": ["fighter_id"],
          "description": "Lookup index for all Tapology method records for a fighter"
        },
        {
          "name": "uq_fighter_method_record_key",
          "columns": ["fighter_id", "scope", "result", "method_category"],
          "unique": true,
          "description": "Idempotent upsert key for Tapology method records"
        }
      ],
      "columns": [
        {
          "column": "fighter_id",
          "type": "integer",
          "nullable": false,
          "description": "Foreign key to fighter"
        },
        {
          "column": "scope",
          "type": "character varying",
          "nullable": false,
          "description": "Record scope",
          "value_format": {"possible_values": ["all_career"]}
        },
        {
          "column": "result",
          "type": "character varying",
          "nullable": false,
          "description": "Result side for this method bucket",
          "value_format": {"possible_values": ["win", "loss"]}
        },
        {
          "column": "method_category",
          "type": "character varying",
          "nullable": false,
          "description": "Method category",
          "value_format": {"possible_values": ["ko_tko", "submission", "decision", "dq", "other"]}
        },
        {
          "column": "count",
          "type": "integer",
          "nullable": true,
          "description": "Number of career fights in this result/method bucket"
        }
      ]
    },
    "event": {
      "description": "UFC event information",
      "relationships": {
        "match": "1:N - Event contains multiple matches"
      },
      "columns": [
        {
          "column": "name",
          "type": "character varying",
          "nullable": false,
          "description": "Event name"
        },
        {
          "column": "event_date",
          "type": "date",
          "nullable": true,
          "description": "Event date",
          "value_format": {"format": "YYYY-MM-DD"}
        },
        {
          "column": "location",
          "type": "character varying",
          "nullable": true,
          "description": "Event location",
          "value_format": {
            "pattern": "city, state/province, country",
            "examples": ["las vegas, nevada, usa", "abu dhabi, abu dhabi, uae"]
          }
        },
        {
          "column": "url",
          "type": "character varying",
          "nullable": true,
          "description": "URL to event detail page on source site"
        },
        {
          "column": "tapology_url",
          "type": "character varying",
          "nullable": true,
          "description": "URL to event detail page on Tapology"
        },
        {
          "column": "latitude",
          "type": "double precision",
          "nullable": true,
          "description": "Event venue latitude coordinate"
        },
        {
          "column": "longitude",
          "type": "double precision",
          "nullable": true,
          "description": "Event venue longitude coordinate"
        }
      ]
    },
    "match": {
      "description": "Individual fight/match information",
      "relationships": {
        "event": "N:1 - Match belongs to one event",
        "fighter_match": "1:N - Match has multiple fighter participants (usually 2)",
        "weight_class": "N:1 - Match belongs to one weight class"
      },
      "indexes": [
        {
          "name": "idx_match_tapology_bout_url",
          "columns": ["tapology_bout_url"],
          "description": "Lookup index for Tapology bout matching"
        },
        {
          "name": "idx_match_bout_status",
          "columns": ["bout_status"],
          "description": "Lookup index for scheduled, completed, cancelled, and postponed Tapology bout status"
        },
        {
          "name": "idx_match_tapology_attempt_status",
          "columns": ["tapology_attempt_status"],
          "description": "Lookup index for Tapology bout enrichment attempt status"
        },
        {
          "name": "idx_match_tapology_last_attempt_at",
          "columns": ["tapology_last_attempt_at"],
          "description": "Lookup index for Tapology bout enrichment retry scheduling"
        }
      ],
      "columns": [
        {
          "column": "event_id",
          "type": "integer",
          "nullable": true,
          "description": "Foreign key to event"
        },
        {
          "column": "weight_class_id",
          "type": "integer",
          "nullable": true,
          "description": "Foreign key to weight_class"
        },
        {
          "column": "is_main_event",
          "type": "boolean",
          "nullable": true,
          "description": "Is this the main event"
        },
        {
          "column": "is_title_bout",
          "type": "boolean",
          "nullable": true,
          "description": "Whether this fight is a title bout"
        },
        {
          "column": "has_fight_of_the_night_bonus",
          "type": "boolean",
          "nullable": false,
          "description": "Whether this fight received Fight of the Night bonus"
        },
        {
          "column": "bout_status",
          "type": "character varying",
          "nullable": true,
          "description": "Tapology-derived bout status",
          "value_format": {"possible_values": ["scheduled", "completed", "cancelled", "postponed", "unknown"]}
        },
        {
          "column": "cancellation_reason",
          "type": "character varying",
          "nullable": true,
          "description": "Cancellation or postponement reason from Tapology when available"
        },
        {
          "column": "tapology_bout_url",
          "type": "character varying",
          "nullable": true,
          "description": "URL to Tapology bout page"
        },
        {
          "column": "tapology_last_scraped_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "description": "Timestamp when Tapology bout enrichment last succeeded"
        },
        {
          "column": "tapology_attempt_status",
          "type": "character varying",
          "nullable": true,
          "description": "Last Tapology bout enrichment attempt status"
        },
        {
          "column": "tapology_last_attempt_at",
          "type": "timestamp without time zone",
          "nullable": true,
          "description": "Timestamp when Tapology bout enrichment was last attempted"
        },
        {
          "column": "tapology_failure_stage",
          "type": "character varying",
          "nullable": true,
          "description": "Tapology bout enrichment stage that last failed"
        },
        {
          "column": "tapology_failure_reason",
          "type": "character varying",
          "nullable": true,
          "description": "Short reason for the last Tapology bout enrichment failure"
        },
        {
          "column": "order",
          "type": "integer",
          "nullable": true,
          "description": "Fight order on card",
          "notes": "biggest number is main event"
        },
        {
          "column": "method",
          "type": "character varying",
          "nullable": true,
          "description": "Finish method",
          "value_format": {
            "pattern": "{CATEGORY}-{TECHNIQUE}",
            "common_prefixes": [
              "SUB-",
              "TKO-",
              "KO-",
              "U-DEC",
              "S-DEC",
              "M-DEC",
              "Overturned-"
            ],
            "examples": [
              "SUB-Rear Naked Choke",
              "TKO-Punches",
              "U-DEC"
            ]
          }
        },
        {
          "column": "result_round",
          "type": "integer",
          "nullable": true,
          "description": "Round the fight ended",
          "value_range": {"min": 1, "max": 5}
        },
        {
          "column": "time",
          "type": "character varying",
          "nullable": true,
          "description": "Time fight ended in round",
          "value_format": {"pattern": "M:SS", "examples": ["5:00", "2:34", "0:45"]},
          "notes": "Time within round when fight ended. if time over 5:00 it need to devided by 5. example: 5:01 -> 0:01"
        },
        {
          "column": "detail_url",
          "type": "character varying",
          "nullable": true,
          "description": "URL to match detail page on source site"
        }
      ]
    },
    "fighter_match": {
      "description": "Junction table linking fighters to matches with results and fighter-side Tapology weigh-in metadata",
      "relationships": {
        "fighter": "N:1 - References one fighter",
        "match": "N:1 - References one match",
        "match_statistics": "1:1 - Fighter match has basic round statistics",
        "strike_detail": "1:1 - Fighter match has detailed strike breakdown"
      },
      "columns": [
        {
          "column": "fighter_id",
          "type": "integer",
          "nullable": false,
          "description": "Foreign key to fighter"
        },
        {
          "column": "match_id",
          "type": "integer",
          "nullable": false,
          "description": "Foreign key to match"
        },
        {
          "column": "result",
          "type": "character varying",
          "nullable": true,
          "description": "Fight result",
          "value_format": {
            "possible_values": [
              "win",
              "loss",
              "draw",
              "nc"
            ]
          }
        },
        {
          "column": "weigh_in_result",
          "type": "character varying",
          "nullable": true,
          "description": "Tapology weigh-in result for this fighter in this match"
        },
        {
          "column": "fight_night_weight",
          "type": "character varying",
          "nullable": true,
          "description": "Tapology fight-night weight for this fighter in this match"
        },
        {
          "column": "weight_gain",
          "type": "character varying",
          "nullable": true,
          "description": "Tapology weight gain from weigh-in to fight night for this fighter in this match"
        },
        {
          "column": "has_performance_of_the_night_bonus",
          "type": "boolean",
          "nullable": false,
          "description": "Whether this fighter received Performance of the Night bonus for this match"
        }
      ]
    },
    "weight_class": {
      "description": "UFC weight class divisions",
      "relationships": {
        "match": "1:N - Weight class has multiple matches",
        "ranking": "1:N - Weight class has multiple rankings"
      },
      "columns": [
        {
          "column": "name",
          "type": "character varying",
          "nullable": false,
          "description": "Weight class name",
          "value_format": {
            "possible_values": {
              "mens_divisions": [
                "flyweight",
                "bantamweight",
                "featherweight",
                "lightweight",
                "welterweight",
                "middleweight",
                "light heavyweight",
                "heavyweight"
              ],
              "womens_divisions": [
                "women's strawweight",
                "women's flyweight",
                "women's bantamweight",
                "women's featherweight"
              ]
            }
          }
        }
      ]
    },
    "ranking": {
      "description": "Fighter rankings within weight classes",
      "relationships": {
        "fighter": "N:1 - References one fighter",
        "weight_class": "N:1 - References one weight class"
      },
      "columns": [
        {
          "column": "fighter_id",
          "type": "integer",
          "nullable": true,
          "description": "Foreign key to fighter"
        },
        {
          "column": "weight_class_id",
          "type": "integer",
          "nullable": true,
          "description": "Foreign key to weight_class"
        },
        {
          "column": "ranking",
          "type": "integer",
          "nullable": true,
          "description": "Rank position",
          "value_format": {"value_range": {"min": 0, "max": 15}},
          "notes": "ranking = 0 means current champion"
        }
      ]
    },
    "match_statistics": {
      "description": "Detailed fight statistics per fighter per round",
      "relationships": {
        "fighter_match": "N:1 - Statistics belong to one fighter's match performance"
      },
      "columns": [
        {
          "column": "fighter_match_id",
          "type": "integer",
          "nullable": true,
          "description": "Foreign key to fighter_match"
        },
        {
          "column": "round",
          "type": "integer",
          "nullable": true,
          "description": "Round number"
        },
        {
          "column": "knockdowns",
          "type": "integer",
          "nullable": true,
          "description": "Knockdowns scored"
        },
        {
          "column": "sig_str_landed",
          "type": "integer",
          "nullable": true,
          "description": "Significant strikes landed"
        },
        {
          "column": "sig_str_attempted",
          "type": "integer",
          "nullable": true,
          "description": "Significant strikes attempted"
        },
        {
          "column": "total_str_landed",
          "type": "integer",
          "nullable": true,
          "description": "Total strikes landed"
        },
        {
          "column": "total_str_attempted",
          "type": "integer",
          "nullable": true,
          "description": "Total strikes attempted"
        },
        {
          "column": "td_landed",
          "type": "integer",
          "nullable": true,
          "description": "Takedowns landed"
        },
        {
          "column": "td_attempted",
          "type": "integer",
          "nullable": true,
          "description": "Takedowns attempted"
        },
        {
          "column": "submission_attempts",
          "type": "integer",
          "nullable": true,
          "description": "Submission attempts"
        },
        {
          "column": "control_time_seconds",
          "type": "integer",
          "nullable": true,
          "description": "Control time in seconds"
        }
      ]
    },
    "strike_detail": {
      "description": "Detailed striking statistics breakdown by target and position",
      "relationships": {
        "fighter_match": "N:1 - Strike details belong to one fighter's match performance"
      },
      "columns": [
        {
          "column": "fighter_match_id",
          "type": "integer",
          "nullable": true,
          "description": "Foreign key to fighter_match"
        },
        {
          "column": "round",
          "type": "integer",
          "nullable": true,
          "description": "Round number"
        },
        {
          "column": "head_strikes_landed",
          "type": "integer",
          "nullable": true,
          "description": "Head strikes landed"
        },
        {
          "column": "head_strikes_attempts",
          "type": "integer",
          "nullable": true,
          "description": "Head strikes attempted"
